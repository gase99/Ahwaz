# ==============================================================================
# 1. Telegram Bot & Local Telegram Bot API Server Configuration
# ==============================================================================
# Token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCDEF_your_bot_token_here

# Telegram API Root:
# - For Local Telegram Bot API Server in Docker Compose: http://telegram-bot-api:8081
# - For Local Telegram Bot API Server on host Linux:     http://127.0.0.1:8081
# - For official Cloud Telegram API:                     https://api.telegram.org
TELEGRAM_API_ROOT=http://telegram-bot-api:8081

# Set true when TELEGRAM_API_ROOT points to a Local Telegram Bot API Server running with --local
# Enables up to 2000 MB file transfers and zero-copy local file path ingestion
TELEGRAM_LOCAL_MODE=true

# Shared directory mounted from telegram-bot-api container (used in --local mode)
TELEGRAM_LOCAL_FILES_DIR=/var/lib/telegram-bot-api

# Required ONLY by the `telegram-bot-api` container in docker-compose.yml (get from https://my.telegram.org)
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_32_char_telegram_api_hash

# ==============================================================================
# 2. Telegram Transport Mode (polling | webhook)
# ==============================================================================
# 'polling' works anywhere without public SSL; 'webhook' uses the built-in Fastify HTTP server
TELEGRAM_MODE=polling

# HTTP Server settings (always runs for /health & /status; also serves /telegram/webhook in webhook mode)
SERVER_HOST=0.0.0.0
SERVER_PORT=3000

# Required only if TELEGRAM_MODE=webhook:
TELEGRAM_WEBHOOK_URL=https://bot.yourdomain.com
TELEGRAM_WEBHOOK_PATH=/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=replace_with_a_strong_random_secret

# ==============================================================================
# 3. Access Control & Security
# ==============================================================================
# Comma-separated Telegram numeric user IDs allowed to control the coding agent.
# Leave empty ONLY in private test environments (strongly recommended to set your ID in production!)
ALLOWED_TELEGRAM_USER_IDS=123456789

# Enable or disable shell command execution (`run_command` tool)
ENABLE_SHELL_EXECUTION=true

# Maximum runtime per shell command in milliseconds (default: 60000 = 60s)
COMMAND_TIMEOUT_MS=60000

# ==============================================================================
# 4. Google Gemini AI Configuration
# ==============================================================================
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here
GEMINI_DEFAULT_MODEL=gemini-2.5-pro
# Maximum autonomous tool-calling iterations per user prompt
AGENT_MAX_STEPS=25

# ==============================================================================
# 5. Workspace, Session Storage & Git Integration
# ==============================================================================
WORKSPACES_ROOT=./workspaces
DATA_DIR=./data

# Optional GitHub Personal Access Token for cloning private repos / pushing / PRs
GITHUB_TOKEN=
GIT_AUTHOR_NAME=Ahwaz Coding Agent
GIT_AUTHOR_EMAIL=agent@ahwaz.local

# Logging level: trace | debug | info | warn | error
LOG_LEVEL=info
NODE_ENV=production
