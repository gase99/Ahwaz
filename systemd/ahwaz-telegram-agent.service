[Unit]
Description=Ahwaz Telegram Coding Agent Service (Google Gemini)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/Ahwaz
EnvironmentFile=/opt/Ahwaz/.env
ExecStart=/usr/bin/node /opt/Ahwaz/dist/index.js
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ahwaz-telegram-agent

# Hardening
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
